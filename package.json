{
  "name": "yyc-class-finder",
  "private": true,
  "version": "0.1.0",
  "description": "Find City of Calgary recreation programs by age, budget, day and activity using the city open-data API.",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "npm --workspace yyc-class-finder-web run dev",
    "build": "npm --workspace yyc-class-finder-web run build",
    "start": "npm --workspace yyc-class-finder-web run start",
    "typecheck": "npm --workspace yyc-class-finder-web run typecheck",
    "lint": "npm --workspace yyc-class-finder-web run lint"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT"
}
